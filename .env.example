# Configurações de Ambiente para Execução Local
# Copie este arquivo para .env e preencha com suas credenciais reais

# Conexão MongoDB (Atlas ou Local)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/portfoliodb?retryWrites=true&w=majority

# Lista de e-mails ou UIDs autorizados como Administradores (separados por vírgula)
ADMIN_EMAILS=admin@seudominio.com
ADMIN_UIDS=

# Origens permitidas para requisições CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Caminho para o arquivo de credenciais do Firebase (ou JSON direto em FIREBASE_CONFIG_JSON)
FIREBASE_CONFIG_PATH=
FIREBASE_CONFIG_JSON=
